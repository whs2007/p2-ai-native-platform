# ===== 模型（OpenAI 兼容：Qwen / DeepSeek / vLLM 均可）=====
# auto = 有 Key 走真实模型，无 Key 自动 Mock（离线演示用）
LLM_MODE=auto
# 默认：阿里云百炼（千问）——本项目 live 已用 qwen-plus 实测通过全流程
# 百炼新用户有各模型免费额度，额度与控制台为准：https://bailian.console.aliyun.com/
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# 备选 DeepSeek：LLM_BASE_URL=https://api.deepseek.com/v1 / LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_S=90
LLM_JSON_MODE=1
# live 模式响应缓存（演示回放更稳）；0 关闭
LLM_CACHE=0

# ===== 平台（mock=本地 JSON；live=HTTP REST 适配层）=====
PLATFORM_MODE=mock
# PLATFORM_MODE=live 时必填；本地演示可先启动 python scripts/platform_stub.py
# PLATFORM_BASE_URL=http://127.0.0.1:8765
# PLATFORM_TOKEN=dev-token
# PLATFORM_TIMEOUT_S=10
# pipeline-fail | rpc-error | 空（仅 mock 模式生效）
SPECFLOW_PLATFORM_FIXTURE=
# 1 = /plan-task 绑定 feature 后在目标仓库创建/切换分支（默认关；不改 commit/push）
SPECFLOW_GIT_BRANCH=0

# ===== 运行时 =====
SPECFLOW_OWNER=lin.xu
SPECFLOW_MAX_ROUNDS=3
SPECFLOW_GATE_REPEAT_LIMIT=3
SPECFLOW_SESSION_BUDGET=900
SPECFLOW_PROMPT_BUDGET=300
SPECFLOW_STRICT_HOOKS=0
SPECFLOW_SPEC_DIR=.spec